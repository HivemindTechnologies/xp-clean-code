{
  "description": "Gate pull request creation on a pr-validation preflight for the current HEAD (Claude Code and Codex)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pr_preflight_gate.py\" --host claude",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^mcp__.*create_pull_request$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pr_preflight_gate.py\" --host claude",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
